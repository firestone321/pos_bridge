# The bridge always binds to 127.0.0.1. Do not expose it through a proxy.
PORT=17891

# The exact browser origin allowed to call this bridge. No wildcard origins.
ALLOWED_ORIGIN=https://admin.firestonesmokehouse.com

# Run `npm run printers` after installing the Windows driver, then use the exact name.
PRINTER_NAME=
PRINTER_PROFILE=s_pos_sp_240_u

# Test one output at a time. Do not test both automatically.
DRAWER_PIN=0
DRAWER_PULSE_MS=80
# Must be at least 10 x DRAWER_PULSE_MS to honour the drawer's 10% duty limit.
DRAWER_COOLDOWN_MS=1000

# development is for the initial local test only. It requires a locally generated secret.
# jwks is the production mode: the Smokehouse backend signs short-lived action tokens.
AUTH_MODE=development
BRIDGE_DEV_SECRET=
BRIDGE_ISSUER=firestone-smokehouse
BRIDGE_AUDIENCE=smokehouse-pos-bridge
# Required when AUTH_MODE=jwks. The planned Smokehouse endpoint is:
# https://admin.firestonesmokehouse.com/api/pos-hardware/jwks
BRIDGE_JWKS_URL=

MAX_REQUEST_BYTES=32768
LOG_LEVEL=info
LOG_DIR=logs
